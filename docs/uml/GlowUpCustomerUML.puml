@startuml GlowUpCustomerUML
title GlowUp — customer package (detailed class diagram)\n- private   # protected   ~ package-private   + public

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 70
skinparam ranksep 80
skinparam class {
  BackgroundColor #FBF8F5
  BorderColor #675A54
  ArrowColor #675A54
}
skinparam note {
  BackgroundColor #FFF6E5
  BorderColor #A87937
}

package "account (detailed later)" {
  class UserAccount <<entity>> {
    - id: Long
    - email: String
    - phone: String [0..1]
    ...
  }
}

package "catalog (detailed later)" {
  class ServiceCategory <<entity>> {
    - id: Long
    - name: String
    ...
  }
}

package "customer" {

  class CustomerProfile <<entity>> <<table: customer_profile>> {
    .. fields ..
    - userId: Long  {PK, FK → user_account.id}
    - user: UserAccount  {@OneToOne @MapsId}
    - fullName: String  {VARCHAR(100), not null}
    - safetyNotes: CustomerSafetyNotes  {@OneToOne, cascade ALL}
    - preferredTimeRanges: List<PreferredTimeRange>  {@OneToMany, cascade ALL, orphanRemoval}
    - preferredCategories: Set<ServiceCategory>  {@ManyToMany, join table}
    .. constructors ..
    # CustomerProfile()  // required by JPA
    + CustomerProfile(user: UserAccount, fullName: String)
    .. getters ..
    + getUserId(): Long
    + getUser(): UserAccount
    + getFullName(): String
    + getSafetyNotes(): CustomerSafetyNotes
    + getPreferredTimeRanges(): List<PreferredTimeRange>  // unmodifiable view
    + getPreferredCategories(): Set<ServiceCategory>  // unmodifiable view
    .. behaviour (instead of raw setters) ..
    + changeFullName(fullName: String): void
    + addPreferredTimeRange(day: DayOfWeek, start: LocalTime, end: LocalTime): PreferredTimeRange
    + removePreferredTimeRange(rangeId: Long): void
    + addPreferredCategory(category: ServiceCategory): void
    + removePreferredCategory(category: ServiceCategory): void
    - validateFullName(fullName: String): String
    .. Object ..
    + equals(o: Object): boolean
    + hashCode(): int
    + toString(): String
  }

  class CustomerSafetyNotes <<entity, sensitive>> <<table: customer_safety_notes>> {
    .. fields ..
    - customerId: Long  {PK, FK → customer_profile.user_id}
    - customer: CustomerProfile  {@OneToOne @MapsId}
    - allergyStatus: AllergyStatus  {VARCHAR(20), not null, default NOT_PROVIDED}
    - allergyDetails: String [0..1]  {VARCHAR(1000)}
    - sensitivities: String [0..1]  {VARCHAR(1000)}
    - updatedAt: Instant  {TIMESTAMP, not null}
    .. constructors ..
    # CustomerSafetyNotes()  // required by JPA
    ~ CustomerSafetyNotes(customer: CustomerProfile)  // only CustomerProfile creates it
    .. getters ..
    + getCustomerId(): Long
    + getCustomer(): CustomerProfile
    + getAllergyStatus(): AllergyStatus
    + getAllergyDetails(): String
    + getSensitivities(): String
    + getUpdatedAt(): Instant
    .. behaviour ..
    + updateAllergies(status: AllergyStatus, details: String): void
    + updateSensitivities(sensitivities: String): void
    + hasKnownAllergies(): boolean
    - touch(): void  {@PrePersist @PreUpdate}
    .. Object ..
    + equals(o: Object): boolean
    + hashCode(): int
    + toString(): String  // never prints details
  }

  class PreferredTimeRange <<entity>> <<table: preferred_time_range>> {
    .. fields ..
    - id: Long  {PK, IDENTITY}
    - customer: CustomerProfile  {@ManyToOne, FK customer_id, not null}
    - dayOfWeek: DayOfWeek  {VARCHAR(9), not null}
    - startTime: LocalTime  {TIME, not null}
    - endTime: LocalTime  {TIME, not null}
    .. constructors ..
    # PreferredTimeRange()  // required by JPA
    ~ PreferredTimeRange(customer: CustomerProfile, day: DayOfWeek, start: LocalTime, end: LocalTime)
    .. getters (no setters: remove and re-add) ..
    + getId(): Long
    + getCustomer(): CustomerProfile
    + getDayOfWeek(): DayOfWeek
    + getStartTime(): LocalTime
    + getEndTime(): LocalTime
    .. behaviour ..
    + overlaps(other: PreferredTimeRange): boolean
    + contains(day: DayOfWeek, time: LocalTime): boolean
    .. Object ..
    + equals(o: Object): boolean
    + hashCode(): int
    + toString(): String
  }

  enum AllergyStatus {
    KNOWN
    NO_KNOWN
    NOT_PROVIDED
  }
}

UserAccount "1" -- "0..1" CustomerProfile : role = CUSTOMER
CustomerProfile "1" *-- "1" CustomerSafetyNotes : created with profile
CustomerProfile "1" *-- "0..*" PreferredTimeRange
CustomerProfile "0..*" --> "0..*" ServiceCategory : preferredCategories\n(join table customer_preferred_category)
CustomerSafetyNotes --> AllergyStatus

note right of CustomerProfile
  <b>Constructor</b> CustomerProfile(user, fullName):
  • user.role must be CUSTOMER
  • fullName trimmed, 1–100 chars
  • creates CustomerSafetyNotes with NOT_PROVIDED

  <b>Why no setters?</b> Each change goes through a method
  that checks its rule, so an entity can't be put in an
  invalid state. JPA reads/writes fields directly.

  addPreferredTimeRange: rejects start >= end and
  overlap with an existing range on the same day.
  add/removePreferredCategory: inactive categories rejected.
  equals/hashCode: by userId (null-safe for new objects).
end note

note right of CustomerSafetyNotes
  updateAllergies(status, details):
  • KNOWN → details required (1–1000 chars)
  • NO_KNOWN / NOT_PROVIDED → details cleared
  DB CHECK mirrors this rule.

  Never loaded by search or public profile queries;
  read only by the customer or the provider of a
  CONFIRMED appointment (checked in the service).
  toString() must not include allergy text (log safety).
end note

note bottom of PreferredTimeRange
  Unique (customer_id, day_of_week, start_time).
  CHECK start_time < end_time.
  overlaps(): same day AND start < other.end
  AND other.start < end.
  Composition: deleting the range from the list
  deletes the row (orphanRemoval).
end note

@enduml
