@startuml GlowUpProviderUML
title GlowUp — provider package (fields)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
  BackgroundColor #FBF8F5
  BorderColor #675A54
  ArrowColor #675A54
}
skinparam note {
  BackgroundColor #FFF6E5
  BorderColor #A87937
}
hide empty methods

class UserAccount <<account>> {
  - id: Long
  - email: String
  - phone: String [0..1]
  ...
}

class ProviderProfile {
  - userId: Long  {PK = UserAccount.id}
  - publicName: String
  - biography: String [0..1]
  - yearsExperience: Integer [0..1]
  - certifications: String [0..1]
  - profileImagePath: String [0..1]
  - address: Address
}

class Address <<embedded>> {
  - street: String
  - city: String
  - state: String
  - zipCode: String
}

class WeeklyAvailability {
  - id: Long
  - dayOfWeek: DayOfWeek
  - startTime: LocalTime
  - endTime: LocalTime
}

UserAccount "1" -- "0..1" ProviderProfile
ProviderProfile *-- "1" Address : stored as columns\nin provider_profile
ProviderProfile "1" -- "0..*" WeeklyAvailability : business hours

note bottom of ProviderProfile
  certifications: free text, shown as "self-reported".
  Search shows city + state only; full street address
  is shown after an appointment is CONFIRMED.
end note
@enduml
